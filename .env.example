# Server-to-server address of the API. Read at request time by lib/server-api.ts
# and by the proxy route, so it is a runtime setting: it must NOT be baked into
# the image. In the cluster this is the in-cluster Service, which no browser can
# reach — that is the point of the proxy route.
API_URL=http://twofree-api:80

# Public address of this application, including the path prefix it is served
# under. Inlined into the client bundle by `next build`, so changing it means
# rebuilding the image. It is only read while rendering on the server, where
# there is no window.location to ask. Public by construction: no secret belongs
# in a NEXT_PUBLIC_* name, because its value ends up in JavaScript the browser
# downloads.
NEXT_PUBLIC_API_URL=https://2free.camir.tech/app
