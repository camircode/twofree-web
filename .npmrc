# The @camircode packages are private on GitHub Packages. Only the mapping lives
# here; the token does not. It arrives as a BuildKit secret mounted at
# /root/.npmrc in the image build, and from the developer's own ~/.npmrc
# otherwise, so it never reaches a layer, a build ARG or this repository.
@camircode:registry=https://npm.pkg.github.com
auto-install-peers=false
prefer-frozen-lockfile=true
strict-peer-dependencies=true
